NAME libssh2
VERSION 1.11.1
DEPENDS openssl VERSION 4.0.0
DEPENDS zlib VERSION 1.3.2
SOURCE URL https://github.com/libssh2/libssh2/releases/download/libssh2-1.11.1/libssh2-1.11.1.tar.gz
SHA256 d9ec76cbe34db98eec3539fe2c899d26b0c837cb3eb466a56b0f109cabf658f7
BUILD_SYSTEM AUTOCONF
AUTOCONF_CONFIGURE env "CPPFLAGS=-I${dep:openssl}/include -I${dep:zlib}/include" "LDFLAGS=-L${dep:openssl}/lib -L${dep:zlib}/lib" ./configure --prefix="${DEPO_PREFIX}" --libdir="${DEPO_PREFIX}/lib" --includedir="${DEPO_PREFIX}/include/libssh2" --disable-shared --with-libssl-prefix="${dep:openssl}" --disable-examples-build --disable-docker-tests --disable-sshd-tests
TARGET libssh2::libssh2 STATIC lib/libssh2.a INTERFACE include
LINK libssh2::libssh2 openssl zlib::zlib
